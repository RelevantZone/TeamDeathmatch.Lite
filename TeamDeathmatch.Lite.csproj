<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net48</TargetFramework>
	<PlatformTarget>x64</PlatformTarget>
	<OutputType>Library</OutputType>
	<LangVersion>12.0</LangVersion>
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
	<AnalysisLevel>latest</AnalysisLevel>
	<Deterministic>true</Deterministic>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>

	<SL_REFERENCE>$(MSBuildProgramFiles32)\Steam\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</SL_REFERENCE>
	<DEP_REFERENCE>$(AppData)\SCP Secret Laboratory\LabAPI\dependencies\global</DEP_REFERENCE>
	<PL_REFERENCE>$(AppData)\SCP Secret Laboratory\LabAPI\plugins\global</PL_REFERENCE>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
    <PackageReference Include="SecretLabNAudio.Core" Version="2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(SL_REFERENCE)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Publicize="true">
      <HintPath>..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(SL_REFERENCE)\CommandSystem.Core.dll</HintPath>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SL_REFERENCE)\Mirror.dll</HintPath>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(SL_REFERENCE)\Pooling.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SL_REFERENCE)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SL_REFERENCE)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Commands\" />
  </ItemGroup>
	
	<ItemGroup>
		<EmbeddedResource Include="Resources/Sounds/**/*" LogicalName="Sounds.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
